<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Katalog Produk</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 pb-10">
    <%- include('partials/navbar') %>

    <div class="max-w-5xl mx-auto mt-10 p-4">
        <div class="flex justify-between items-center mb-8">
            <h1 class="text-3xl font-bold text-gray-800">Katalog Peyek Enak</h1>
            <!-- Tombol Tambah Data -->
            <a href="/katalog/tambah" class="bg-blue-600 text-white px-4 py-2 rounded shadow hover:bg-blue-700">Tambah Produk</a>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <% products.forEach(product => { %>
                <div class="bg-white p-5 rounded-xl shadow-md border hover:shadow-lg transition">
                    <h2 class="text-xl font-semibold"><%= product.nama %></h2>
                    <p class="text-sm text-gray-500 mb-2">Varian: <%= product.varian %></p>
                    <p class="text-2xl font-bold text-orange-500 mb-4">Rp <%= product.harga %></p>
                    
                    <div class="flex justify-between space-x-2 mt-4">
                        <a href="/kontak?produk=<%= product.nama %>" class="bg-green-500 text-white px-4 py-2 rounded-lg hover:bg-green-600 font-medium w-full text-center">Pesan</a>
                        <!-- Form Hapus Data -->
                        <form action="/katalog/hapus/<%= product.id %>" method="POST" onsubmit="return confirm('Yakin hapus?');">
                            <button type="submit" class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600">Hapus</button>
                        </form>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</body>
</html>